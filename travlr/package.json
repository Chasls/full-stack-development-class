{
  "name": "travlr",
  "version": "1.0.0",
  "private": true,
  "description": "Module Six Travlr Getaways full stack application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "seed": "node app_api/models/seed.js",
    "inspect": "node app_api/models/inspect.js",
    "seed:module6": "node app_api/models/seed.js data/module6-added-trip.json",
    "build:admin": "npm --prefix app_admin run build",
    "test:admin": "npm --prefix app_admin test -- --watch=false"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "express": "^5.2.1",
    "hbs": "^4.2.0",
    "mongoose": "^8.24.4"
  }
}
