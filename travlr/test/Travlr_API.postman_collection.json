    {
      "name": "Register mock regular user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/register",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Mock User\", \"email\": \"{{mockEmail}}\", \"password\": \"Mock-password-2026!\", \"role\": \"admin\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('returns HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('userToken', pm.response.json().token);",
              "pm.test('password is not returned', () => pm.expect(pm.response.json()).not.to.have.property('password'));"
            ]
          }
        }
      ]
    },
